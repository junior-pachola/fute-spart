# Copie para `.env` e preencha com os dados do seu projeto Firebase
# (Console → Configurações do projeto → Seus apps → App da Web).
# O `.env` NÃO vai pro git. Sem preencher, o app roda em MODO LOCAL.

VITE_FIREBASE_API_KEY=sua_api_key
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
