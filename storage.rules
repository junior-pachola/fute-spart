rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos do clube: leitura pública, escrita só de imagens até 5 MB.
    match /spartax/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
